#!/usr/bin/env bash
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
    git ls-tree -r --name-only "$local_sha" >> "$TMP"
  else
    git diff --name-only --diff-filter=ACMR "$remote_sha" "$local_sha" >> "$TMP"
  fi
done

if [ ! -s "$TMP" ]; then
  exit 0
fi

sort -u "$TMP" -o "$TMP"

if ! python -c 'import yaml' >/dev/null 2>&1; then
  echo "pre-push: falta PyYAML. Instala con: python -m pip install pyyaml" >&2
  exit 1
fi

exec python "$ROOT/.githooks/validate.py" --repo-root "$ROOT" --files-from "$TMP"
